#. Plugin Name of the plugin
#: hypermedia-carousel-for-datastar.php
msgid "Hypermedia Carousel for Datastar"
msgstr "Diaporama ultraléger via SSE"

#. Plugin URI of the plugin
#: hypermedia-carousel-for-datastar.php
msgid "https://github.com/ltruchot/hypermedia-carousel-for-datastar"
msgstr ""

#. Description of the plugin
#: hypermedia-carousel-for-datastar.php
msgid "An image carousel that ships one slide in the page and streams the rest over Server-Sent Events."
msgstr "Un diaporama qui met une seule image dans la page et pousse les suivantes en Server-Sent Events."

#. Author of the plugin
#: hypermedia-carousel-for-datastar.php
msgid "Loïc Truchot"
msgstr ""

#. Author URI of the plugin
#: hypermedia-carousel-for-datastar.php
msgid "https://github.com/ltruchot"
msgstr ""

#: blocks/carousel/render.php:33
msgid "Image carousel"
msgstr "Diaporama d’images"

#: blocks/carousel/render.php:124
msgid "carousel"
msgstr "diaporama"

#: blocks/carousel/render.php:171
msgid "Pause slideshow"
msgstr "Mettre le diaporama en pause"

#: blocks/carousel/render.php:174
msgid "Play slideshow"
msgstr "Lancer le diaporama"

#: blocks/carousel/render.php:183
msgid "Previous slide"
msgstr "Image précédente"

#: blocks/carousel/render.php:191
msgid "Next slide"
msgstr "Image suivante"

#. translators: 1: required PHP version, 2: required WordPress version.
#: hypermedia-carousel-for-datastar.php:55
#, php-format
msgid "Hypermedia Carousel for Datastar requires PHP %1$s and WordPress %2$s or later."
msgstr "Diaporama ultraléger via SSE demande PHP %1$s et WordPress %2$s ou plus récents."

#: includes/class-settings.php:89
msgid "Settings"
msgstr "Réglages"

#. translators: 1: shortest allowed interval, 2: longest allowed interval, both in seconds.
#: includes/class-settings.php:131
#, php-format
msgid "The rotation interval must be between %1$d and %2$d seconds. Your value was adjusted."
msgstr "L’intervalle de rotation doit être compris entre %1$d et %2$d secondes. Votre valeur a été ajustée."

#: includes/class-settings.php:212
#: includes/class-settings.php:213
#: blocks/carousel/index.js:111
msgid "Hypermedia Carousel"
msgstr "Diaporama ultraléger"

#: includes/class-settings.php:243
msgid "Seconds per slide"
msgstr "Secondes par image"

#: includes/class-settings.php:252
msgid "View transition"
msgstr "Transition de vue"

#: includes/class-settings.php:266
msgid "Pick the images inside the Hypermedia Carousel block. This page holds the one setting shared by every carousel on the site."
msgstr "Les images se choisissent dans le bloc Diaporama ultraléger. Cette page ne porte que les réglages communs à tous les diaporamas du site."

#. translators: 1: shortest allowed interval, 2: longest allowed interval, both in seconds.
#: includes/class-settings.php:292
#, php-format
msgid "Between %1$d and %2$d. A carousel of a single image never rotates, whatever this says."
msgstr "Entre %1$d et %2$d. Un diaporama d’une seule image ne tourne jamais, quoi que dise ce réglage."

#: includes/class-settings.php:307
msgid "Cross-fade — the browser fades one slide into the next"
msgstr "Fondu — le navigateur fait passer une image dans l’autre"

#: includes/class-settings.php:308
msgid "None — the slide is simply replaced"
msgstr "Aucune — l’image est simplement remplacée"

#: includes/class-settings.php:320
msgid "Visitors who asked their system for reduced motion never get a transition, whatever this says."
msgstr "Les visiteurs qui ont demandé un mouvement réduit à leur système n’ont jamais de transition, quoi que dise ce réglage."

#: includes/class-slides.php:194
msgid "slide"
msgstr "image"

#. translators: 1: slide number, 2: total number of slides.
#: includes/class-slides.php:198
#, php-format
msgid "%1$d of %2$d"
msgstr "%1$d sur %2$d"

#: includes/class-sse-endpoint.php:120
msgid "This carousel request was not issued by this site."
msgstr "Cette demande de diaporama n’a pas été émise par ce site."

#: blocks/carousel/index.js:23
msgid "Thumbnail"
msgstr "Miniature"

#: blocks/carousel/index.js:24
msgid "Medium"
msgstr "Moyenne"

#: blocks/carousel/index.js:25
msgid "Large"
msgstr "Grande"

#: blocks/carousel/index.js:26
msgid "Full size"
msgstr "Taille originale"

#: blocks/carousel/index.js:44
msgid "Carousel"
msgstr "Diaporama"

#: blocks/carousel/index.js:46
msgid "Image size"
msgstr "Taille des images"

#: blocks/carousel/index.js:55
msgid "Accessible name"
msgstr "Nom accessible"

#: blocks/carousel/index.js:56
msgid "Announced to screen readers, for example “Life at the school”. Leave empty for a generic name."
msgstr "Annoncé aux lecteurs d’écran, par exemple « La vie à l’école ». Laisser vide pour un nom générique."

#: blocks/carousel/index.js:83
msgid "Edit images"
msgstr "Modifier les images"

#: blocks/carousel/index.js:84
msgid "Add images"
msgstr "Ajouter des images"

#: blocks/carousel/index.js:92
msgid "The seconds each slide stays on screen are set once for the whole site, under Settings → Hypermedia Carousel."
msgstr "Le temps d’affichage de chaque image se règle une fois pour tout le site, dans Réglages → Diaporama ultraléger."

#: blocks/carousel/index.js:112
msgid "Pick the images this carousel rotates through. One image never rotates; two or more start the loop."
msgstr "Choisissez les images que ce diaporama fera défiler. Une seule image ne tourne jamais ; deux ou plus lancent la boucle."

#: blocks/carousel/block.json
msgctxt "block title"
msgid "Hypermedia Carousel"
msgstr "Diaporama ultraléger"

#: blocks/carousel/block.json
msgctxt "block description"
msgid "Ships one slide in the page and streams the rest over Server-Sent Events, so a carousel costs what a single image costs."
msgstr "Met une seule image dans la page et pousse les suivantes en Server-Sent Events : le diaporama ne coûte alors que ce que coûte une image."

#: blocks/carousel/block.json
msgctxt "block keyword"
msgid "carousel"
msgstr "carousel"

#: blocks/carousel/block.json
msgctxt "block keyword"
msgid "slideshow"
msgstr "diaporama"

#: blocks/carousel/block.json
msgctxt "block keyword"
msgid "gallery"
msgstr "galerie"

#: blocks/carousel/block.json
msgctxt "block keyword"
msgid "slider"
msgstr "carrousel"
